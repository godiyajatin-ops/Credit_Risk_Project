# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Virtual Environments
venv/
env/
ENV/

# VS Code / IDE settings
.vscode/
.idea/

# Large Raw and Processed Datasets (Preventing Git LFS overhead)
data/raw/*.csv
data/processed/*.csv

# OS Generated Files
.DS_Store
Thumbs.db
